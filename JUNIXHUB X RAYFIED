local function createNavButton(text)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 160, 0, 42)
    Button.BackgroundColor3 = Color3.fromRGB(12, 24, 44)
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(180, 215, 255)
    Button.Font = Enum.Font.GothamSemibold
    Button.TextSize = 14
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false
    Button.Parent = Sidebar

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Button

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(20, 70, 130)
    Stroke.Thickness = 1
    Stroke.Parent = Button

    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(15, 65, 125)
        Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(12, 24, 44)
        Button.TextColor3 = Color3.fromRGB(180, 215, 255)
    end)

    return Button
end

